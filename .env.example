# .env.example - Copy this to .env and customize as needed

# Target websites for scraping (comma-separated URLs)
TARGET_URLS=https://www.saudiexchange.sa,https://www.nasdaqdubai.com,https://www.lseg.com

# Output directories
PDF_OUTPUT_DIR=./output/pdfs
CSV_OUTPUT_PATH=./output/emissions_data.csv

# Browser settings
HEADLESS=true
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Scraping limits
MAX_PDFS_PER_SITE=50
DOWNLOAD_TIMEOUT=60000
MAX_RETRIES=3

# Optional: API Keys (for future enhancements)
# CDP_API_KEY=your_cdp_api_key_here
# PROXY_URL=your_proxy_url_here
